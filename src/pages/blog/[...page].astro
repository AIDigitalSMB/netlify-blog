---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts, type Post } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../consts';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Post> };

const title = page.currentPage === 1 ? 'Blog' : `Blog — page ${page.currentPage}`;
---

<BaseLayout
  title={title}
  description="Every post, newest first."
  noindex={page.currentPage > 1}
>
  <header class="section-head" style="margin-block-end: 2rem;">
    <div>
      <p class="eyebrow">Archive</p>
      <h1>Blog</h1>
    </div>
    <p class="meta">{page.total} {page.total === 1 ? 'post' : 'posts'}</p>
  </header>

  <ul class="post-grid">
    {page.data.map((post, i) => <PostCard post={post} eager={page.currentPage === 1 && i < 3} />)}
  </ul>

  <Pagination
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    current={page.currentPage}
    total={page.lastPage}
  />
</BaseLayout>
