---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories } from '../../lib/posts';
import { withBase } from '../../lib/url';
import { AUTHOR_NAME, AUTHOR_BIO, SITE_TITLE, FEATURES } from '../../consts';

/**
 * Gated route. When FEATURES.about is false this returns no paths, so the page is
 * never generated and /about/ 404s. Flip the flag in src/consts.ts to bring it back —
 * nothing here changes.
 */
export const getStaticPaths = (() =>
  FEATURES.about ? [{ params: { slug: undefined } }] : []) satisfies GetStaticPaths;

const posts = await getPosts();
const categories = getCategories(posts);
---

<BaseLayout
  title="About"
  description={`About ${AUTHOR_NAME} and ${SITE_TITLE}.`}
  narrow
>
  <article class="prose" data-pagefind-body>
    <p class="eyebrow">About</p>
    <h1>{AUTHOR_NAME}</h1>
    <p class="lead">{AUTHOR_BIO}</p>

    <p>
      Replace this paragraph with your own introduction. A couple of sentences on what you
      do, what you are working on now, and why you write here is plenty — readers arriving
      from a search result mostly want to know whose opinion they are reading.
    </p>

    <h2>What you will find here</h2>
    <p>
      {SITE_TITLE} currently has {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      across {categories.length} {categories.length === 1 ? 'category' : 'categories'}:
    </p>
    <ul>
      {
        categories.map((category) => (
          <li>
            <a href={withBase(`/category/${category.slug}/`)}>{category.name}</a> — {category.count}{' '}
            {category.count === 1 ? 'post' : 'posts'}
          </li>
        ))
      }
    </ul>

    <h2>Staying in touch</h2>
    {
      FEATURES.contact ? (
        <p>
          New posts go out on the <a href={withBase('/rss.xml')}>RSS feed</a>. If you would
          rather write to me directly, the <a href={withBase('/contact/')}>contact page</a> has
          the details.
        </p>
      ) : (
        <p>
          New posts go out on the <a href={withBase('/rss.xml')}>RSS feed</a>.
        </p>
      )
    }

    <h2>How this site is built</h2>
    <p>
      Static pages generated by Astro, written in Markdown, edited through a Git-based CMS and
      deployed to Netlify by its Git integration. No tracking scripts, no cookie banner, and no
      client-side JavaScript beyond a theme toggle, the search page and the comment widget.
    </p>
  </article>
</BaseLayout>
