---
import type { GetStaticPaths } from 'astro';
import { FEATURES } from '../../consts';

/**
 * Gated route. When FEATURES.search is false this returns no paths, so the page is
 * never generated and /search/ 404s. Flip the flag in src/consts.ts to bring it back —
 * nothing here changes.
 */
export const getStaticPaths = (() =>
  FEATURES.search ? [{ params: { slug: undefined } }] : []) satisfies GetStaticPaths;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/url';

// Pagefind indexes the built output, so its bundle only exists after
// `npm run build` (see the postbuild step in package.json). During `astro dev`
// the loader below fails gracefully and shows the notice instead.
const bundlePath = withBase('/pagefind/');
const basePath = withBase('/');
---

<BaseLayout title="Search" description="Search every post on this blog." narrow noindex>
  <p class="eyebrow">Search</p>
  <h1>Search the archive</h1>
  <p class="lead">Full-text search across every published post. Runs entirely in your browser.</p>

  <div id="search" data-bundle={bundlePath} data-base={basePath}></div>

  <p class="note" id="search-fallback" hidden>
    The search index is not available. It is generated by <code>npm run build</code> and ships
    with the deployed site, so this page only works against a built site — try{' '}
    <code>npm run preview</code> locally, or browse{' '}
    <a href={withBase('/blog/')}>all posts</a> instead.
  </p>
</BaseLayout>

<script is:inline>
  (() => {
    const el = document.getElementById('search');
    const fallback = document.getElementById('search-fallback');
    if (!el) return;

    const bundle = el.dataset.bundle;
    const base = el.dataset.base;

    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = `${bundle}pagefind-ui.css`;
    document.head.appendChild(css);

    const js = document.createElement('script');
    js.src = `${bundle}pagefind-ui.js`;
    js.onerror = () => {
      if (fallback) fallback.hidden = false;
    };
    js.onload = () => {
      new window.PagefindUI({
        element: '#search',
        bundlePath: bundle,
        showImages: false,
        showSubResults: true,
        autofocus: true,
        // Pagefind indexes dist/, which is the deploy root, so its result URLs
        // start at "/" and need the site base putting back on the front.
        processResult: (result) => {
          if (result.url.startsWith('/') && !result.url.startsWith(base)) {
            result.url = base + result.url.slice(1);
          }
          return result;
        },
      });
    };
    document.head.appendChild(js);
  })();
</script>
