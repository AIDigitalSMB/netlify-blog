---
import type { GetStaticPaths } from 'astro';
import { FEATURES } from '../../consts';

/**
 * Gated route. When FEATURES.contact is false this returns no paths, so the page is
 * never generated and /contact/ 404s. Flip the flag in src/consts.ts to bring it back —
 * nothing here changes.
 */
export const getStaticPaths = (() =>
  FEATURES.contact ? [{ params: { slug: undefined } }] : []) satisfies GetStaticPaths;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR_EMAIL, CONTACT_FORM_ENDPOINT } from '../../consts';

// This is a static site (no server), so a working form needs a third-party
// endpoint. CONTACT_FORM_ENDPOINT is deliberately empty: paste your own Formspree
// (or equivalent) URL into src/consts.ts. Until then the mailto link is the fallback.
const hasForm = CONTACT_FORM_ENDPOINT.length > 0;
---

<BaseLayout title="Contact" description="How to get in touch." narrow>
  <div class="prose">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lead">
      Questions, corrections, or something you think I should write about — all welcome.
    </p>

    <p>
      The quickest route is email: <a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a>.
    </p>
  </div>

  {
    hasForm ? (
      <form class="form" action={CONTACT_FORM_ENDPOINT} method="POST">
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label for="email">Your email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required />
        </div>

        {/* Honeypot: real people leave it empty, most bots do not. */}
        <div class="visually-hidden" aria-hidden="true">
          <label for="_gotcha">Leave this field empty</label>
          <input id="_gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <button class="button" type="submit">Send message</button>
        </div>
      </form>
    ) : (
      <p class="note">
        <strong>Contact form not configured.</strong> Create a form at{' '}
        <a href="https://formspree.io" rel="noopener">
          formspree.io
        </a>{' '}
        (or any static-site form service), then paste the endpoint URL into{' '}
        <code>CONTACT_FORM_ENDPOINT</code> in <code>src/consts.ts</code>. The form markup is
        already written and will appear here as soon as the value is set.
      </p>
    )
  }
</BaseLayout>
